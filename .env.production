# ==========================================
# SECURE NOTES - FRONTEND PRODUCTION CONFIG
# ==========================================

# Public API URL accessible from the client browser
# IMPORTANT: In Next.js, this is bundled during `npm run build`
# If using IP: http://YOUR_VPS_IP:5000/api
# If using Domain with Nginx: https://api.yourdomain.com/api or https://yourdomain.com/api
NEXT_PUBLIC_API_URL=http://YOUR_VPS_IP:5000/api
